# === Finance Dashboard (Musterdepot) — example environment. Copy to .env and fill in. ===

# --- Database & app ---
DB_BACKEND=sqlite
DB_URL=sqlite:///./musterdepot.sqlite
SECRET_KEY=please-change-me-32-bytes-random
LOG_LEVEL=INFO

# Production (MariaDB), example:
# DB_BACKEND=mariadb
# DB_URL=mariadb+mariadbconnector://user:pw@localhost:3306/musterdepot_prod

# --- UI language (REQ-I18N; German is the first implemented language) ---
DEFAULT_SPRACHE=de

# --- Domain behaviour ---
BARBESTAND_UEBERZIEHEN_ERLAUBEN=false
VERRECHNUNGSMETHODE=FIFO            # FIFO | DURCHSCHNITT

# --- Encryption of provider credentials stored in the DB (setup page, spec §6.6).
#     Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENC_KEY=

# --- Price providers (bootstrap/fallback defaults; runtime config via setup page) ---
PROVIDER_AKTIEN_ETF=fmp
PROVIDER_HEBELPRODUKT=pytr
KURS_CACHE_TTL=60

# FMP (bootstrap/fallback) — quotes for stocks/ETFs and FX rates
FMP_API_KEY=

# FX provider (bootstrap/fallback; runtime config via setup page, spec §6.10)
FX_PROVIDER=fmp

# pytr / Trade Republic (bootstrap/fallback; secrets — never logged)
PYTR_PHONE_NO=
PYTR_PIN=
PYTR_KEYFILE=

# --- MCP server (streamable HTTP; run behind a TLS reverse proxy) ---
MUSTERDEPOT_MCP_KEY=
MUSTERDEPOT_MCP_HOST=127.0.0.1
MUSTERDEPOT_MCP_PORT=8000
